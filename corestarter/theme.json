{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#2563eb"
				},
				{
					"name": "Primary Dark",
					"slug": "primary-dark",
					"color": "#1e40af"
				},
				{
					"name": "Text",
					"slug": "text",
					"color": "#1f2937"
				},
				{
					"name": "Text Light",
					"slug": "text-light",
					"color": "#6b7280"
				},
				{
					"name": "Background",
					"slug": "background",
					"color": "#ffffff"
				},
				{
					"name": "Background Alt",
					"slug": "background-alt",
					"color": "#f9fafb"
				},
				{
					"name": "Border",
					"slug": "border",
					"color": "#e5e7eb"
				},
				{
					"name": "Footer Background",
					"slug": "footer-bg",
					"color": "#1f2937"
				}
			],
			"custom": true,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultDuotone": false,
			"defaultGradients": false
		},
		"typography": {
			"fluid": true,
			"fontSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"name": "Normal",
					"slug": "normal",
					"size": "1rem",
					"fluid": false
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1.125rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.375rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.375rem"
					}
				},
				{
					"name": "X-Large",
					"slug": "x-large",
					"size": "1.75rem",
					"fluid": {
						"min": "1.375rem",
						"max": "1.75rem"
					}
				},
				{
					"name": "2X-Large",
					"slug": "2x-large",
					"size": "2rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2rem"
					}
				},
				{
					"name": "3X-Large",
					"slug": "3x-large",
					"size": "2.5rem",
					"fluid": {
						"min": "1.875rem",
						"max": "2.5rem"
					}
				}
			],
			"fontFamilies": [
				{
					"name": "System Default",
					"slug": "system-default",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif"
				}
			],
			"customFontSize": true,
			"defaultFontSizes": false
		},
		"spacing": {
			"spacingSizes": [
				{ "name": "1", "slug": "10", "size": "0.5rem" },
				{ "name": "2", "slug": "20", "size": "1rem" },
				{ "name": "3", "slug": "30", "size": "1.5rem" },
				{ "name": "4", "slug": "40", "size": "2rem" },
				{ "name": "5", "slug": "50", "size": "3rem" },
				{ "name": "6", "slug": "60", "size": "4rem" }
			],
			"units": [ "px", "rem", "em", "vh", "vw", "%" ],
			"defaultSpacingSizes": false,
			"customSpacingSize": true
		},
		"layout": {
			"contentSize": "1440px",
			"wideSize": "1600px"
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"presets": [
				{
					"name": "Subtle",
					"slug": "subtle",
					"shadow": "0 2px 8px rgba(0, 0, 0, 0.08)"
				},
				{
					"name": "Card",
					"slug": "card",
					"shadow": "0 4px 16px rgba(0, 0, 0, 0.06)"
				},
				{
					"name": "Elevated",
					"slug": "elevated",
					"shadow": "0 8px 32px rgba(0, 0, 0, 0.12)"
				}
			],
			"defaultPresets": false
		},
		"blocks": {
			"core/image": {
				"color": {
					"duotone": []
				}
			}
		},
		"useRootPaddingAwareAlignments": false
	},
	"styles": {
		"color": {
			"background": "#ffffff",
			"text": "#1f2937"
		},
		"typography": {
			"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen-Sans, Ubuntu, Cantarell, \"Helvetica Neue\", sans-serif",
			"fontSize": "1rem",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": {
					"text": "#2563eb"
				},
				":hover": {
					"color": {
						"text": "#1e40af"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "2.5rem",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "2rem",
					"fontWeight": "700",
					"lineHeight": "1.3"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.75rem",
					"fontWeight": "600",
					"lineHeight": "1.3"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.5rem",
					"fontWeight": "600",
					"lineHeight": "1.4"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "1.25rem",
					"fontWeight": "600",
					"lineHeight": "1.4"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "1rem",
					"fontWeight": "600",
					"lineHeight": "1.4"
				}
			},
			"button": {
				"color": {
					"background": "#2563eb",
					"text": "#ffffff"
				},
				"border": {
					"radius": "6px"
				},
				"typography": {
					"fontWeight": "500"
				},
				":hover": {
					"color": {
						"background": "#1e40af",
						"text": "#ffffff"
					}
				}
			}
		},
		"blocks": {
			"core/quote": {
				"border": {
					"color": "#2563eb",
					"style": "solid",
					"width": "0 0 0 4px"
				},
				"color": {
					"background": "#f9fafb"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"bottom": "1rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "#e5e7eb"
				}
			}
		}
	}
}
